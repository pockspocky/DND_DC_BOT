# Discord机器人配置
DISCORD_TOKEN=your_discord_bot_token_here
PREFIX=!
DEBUG=True

# AI场景生成器配置
GEMINI_API_KEY=your_gemini_api_key_here

# 代理配置 (可选)
# 如果需要代理连接Discord，请取消注释并填写代理地址
# PROXY_URL=http://127.0.0.1:7890

# 数据库配置
DATABASE_URL=sqlite:///dnd_bot.db
DATABASE_PATH=dnd_bot.db

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=bot.log

# 数据清理配置
CLEANUP_DAYS=30 