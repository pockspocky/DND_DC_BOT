# ============================================================================
# DND_DC_BOT Docker Environment Configuration Template
# ============================================================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env in the same directory:
#    cp docker.env.example .env
# 
# 2. Fill in your actual values for the required variables below
# 
# 3. Deploy the bot using the deployment script:
#    ./deploy-docker.sh
# 
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED VARIABLES
# ----------------------------------------------------------------------------

# Discord Bot Token (REQUIRED)
# Get your token from: https://discord.com/developers/applications
# 1. Create a new application or select an existing one
# 2. Go to the "Bot" section
# 3. Click "Reset Token" to generate a new token
# 4. Copy the token and paste it here
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (REQUIRED for AI scene generation)
# Get your API key from: https://makersuite.google.com/app/apikey
# 1. Sign in with your Google account
# 2. Click "Create API Key"
# 3. Copy the API key and paste it here
# Note: Scene generation (/scene command) will not work without this key
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------------------------
# OPTIONAL VARIABLES (with defaults)
# ----------------------------------------------------------------------------

# Bot Command Prefix
# Default: !
# The prefix used for text-based commands (slash commands don't need prefix)
PREFIX=!

# Database File Path
# Default: /app/dnd_bot.db (Docker internal path)
# For Docker deployment, use the internal path shown above
# The database file is automatically mounted as a volume for persistence
DATABASE_PATH=/app/dnd_bot.db

# Logging Level
# Default: INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Most verbose, shows all details (useful for troubleshooting)
# INFO: Normal operation information
# WARNING: Warning messages only
# ERROR: Error messages only
# CRITICAL: Critical errors only
LOG_LEVEL=INFO

# Debug Mode
# Default: false
# Set to true to enable additional debug output
# Options: true, false
DEBUG=false

# API Request Timeout
# Default: 30 (seconds)
# Maximum time to wait for external API responses (D&D 5e API, Gemini API)
# Increase if you experience timeout errors on slow connections
API_TIMEOUT=30

# Cache Expiration Time
# Default: 3600 (seconds = 1 hour)
# How long to cache D&D 5e API query results (spells, monsters, skills)
# Longer cache reduces API calls but may show outdated data
# Set to 0 to disable caching (not recommended)
CACHE_EXPIRE=3600

# ----------------------------------------------------------------------------
# ADVANCED OPTIONS (usually not needed)
# ----------------------------------------------------------------------------

# Database URL (alternative to DATABASE_PATH)
# Default: sqlite:///dnd_bot.db
# Only needed if using a different database configuration
# DATABASE_URL=sqlite:///dnd_bot.db

# Log File Name
# Default: bot.log
# Name of the main log file (stored in logs/ directory)
# LOG_FILE=bot.log

# Data Cleanup Days
# Default: 30
# Number of days to keep old dice roll history before cleanup
# Set to 0 to disable automatic cleanup
# CLEANUP_DAYS=30

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# 
# - Lines starting with # are comments and are ignored
# - Do not use quotes around values unless they contain spaces
# - The .env file should never be committed to version control
# - Keep your tokens and API keys secure and private
# - After changing values, restart the bot: ./deploy-docker.sh --restart
# 
# ============================================================================
