# Docker部署环境变量配置
# 复制此文件为 .env 并填写正确的值

# Discord机器人令牌（必填）
DISCORD_TOKEN=your_discord_bot_token_here

# AI场景生成器API密钥（必填）
GEMINI_API_KEY=your_gemini_api_key_here

# 代理配置（可选）
# 如果你的网络环境需要代理才能访问Discord，请填写代理地址
PROXY_URL=http://127.0.0.1:7890

# 机器人命令前缀（可选，默认为 !）
PREFIX=!

# 数据库路径（Docker内部路径，一般不需要修改）
DATABASE_PATH=/app/dnd_bot.db

# 日志级别（可选，默认为 INFO）
LOG_LEVEL=INFO

# 是否启用调试模式（可选，默认为 false）
DEBUG=false

# API超时设置（可选，默认为 30秒）
API_TIMEOUT=30

# 缓存过期时间（可选，默认为 3600秒 = 1小时）
CACHE_EXPIRE=3600 